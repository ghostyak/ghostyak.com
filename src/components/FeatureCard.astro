---
interface Props { number: string; title: string; description: string; }
const { number, title, description } = Astro.props;
---

<article>
	<span>{number}</span>
	<h3>{title}</h3>
	<p>{description}</p>
</article>

<style>
	article { border: 1px solid #dce4ef; border-radius: 18px; background: white; padding: 28px; box-shadow: 0 18px 60px rgb(23 53 92 / 7%); }
	span { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: #e8f8ff; color: #0878ad; font-size: 0.82rem; font-weight: 800; }
	h3 { margin: 22px 0 10px; font-size: 1.2rem; letter-spacing: -0.025em; }
	p { margin: 0; color: #5b6980; font-size: 0.98rem; line-height: 1.7; }
</style>
