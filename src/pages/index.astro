---
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { boxes } from '../data/products';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Ghostyak Boxes — 바탕화면을 더 단정하게';
---

<BaseLayout title={title} description={boxes.description}>
	<Header />
	<main>
		<section class="hero">
			<div class="container hero-inner">
				<div class="hero-copy">
					<div class="product-title">
						<img src="/images/boxes-icon.png" alt="" width="84" height="84" />
						<p>Ghostyak Boxes</p>
					</div>
					<h1>필요한 파일이 한눈에 보이는 바탕화면</h1>
					<p class="intro">흩어진 파일과 바로가기를 나만의 박스에 모아보세요.</p>
					<div class="hero-actions" id="download">
						<a class="primary-button" href={boxes.downloadUrl}>Windows용 다운로드</a>
					</div>
					<p class="hero-meta">버전 {boxes.version} · {boxes.platform} · {boxes.fileSize}</p>
					<p class="preview-notice"><strong>초기 개발 버전</strong> — 중요한 바탕화면 구성에서는 별도의 Windows 사용자 환경에서 먼저 시험해 주세요.</p>
				</div>
				<figure>
					<img src="/images/boxes-hero-concept-v3.png" alt="넓은 바탕화면 오른쪽에 사진과 앱을 두 개의 박스로 정리한 Boxes 콘셉트 화면" width="1672" height="941" />
				</figure>
			</div>
		</section>

		<section class="features" id="features" aria-labelledby="features-title">
			<div class="container">
				<p class="section-label">주요 기능</p>
				<h2 id="features-title">파일은 한곳에 모으고,<br />필요한 순간 바로 찾으세요.</h2>
				<div class="feature-grid">
					<FeatureCard number="01" title="박스 단위로 정리" description="파일, 폴더와 바로가기를 목적에 맞는 여러 박스로 나누어 한눈에 찾을 수 있습니다." />
					<FeatureCard number="02" title="내 방식대로 배치" description="박스를 이동하거나 크기를 조절하고, 접기와 잠금으로 필요한 공간만 남길 수 있습니다." />
					<FeatureCard number="03" title="화면 구성별 복원" description="모니터 구성에 맞춰 박스의 위치와 크기를 기억해 익숙한 작업 환경을 유지합니다." />
					<FeatureCard number="04" title="사진 뷰어" description="박스 안의 사진과 폴더 속 이미지를 슬라이드쇼로 감상하고 전환 간격과 순서를 설정할 수 있습니다." />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style>
	.hero { position: relative; overflow: hidden; background: linear-gradient(180deg, #dce9f3 0%, #edf4f9 58%, #fff 100%); color: #14243a; }
	.hero::after { position: absolute; top: -260px; left: 50%; width: 900px; height: 520px; border-radius: 50%; background: #fff; content: ""; filter: blur(100px); opacity: 0.75; transform: translateX(-50%); }
	.hero-inner { position: relative; z-index: 1; display: flex; min-height: calc(100vh - 68px); align-items: center; flex-direction: column; padding-block: 46px 82px; }
	.hero-copy { display: flex; align-items: center; flex-direction: column; text-align: center; }
	.product-title { display: flex; align-items: center; justify-content: center; gap: 16px; }
	.product-title img { object-fit: contain; }
	.product-title p { margin: 0; color: #125697; font-size: clamp(2rem, 4vw, 3.35rem); font-weight: 650; letter-spacing: -0.035em; }
	.eyebrow, .section-label { margin: 32px 0 15px; color: #54d8ff; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
	h1 { margin: 22px 0 0; font-size: clamp(1.7rem, 3.2vw, 2.5rem); line-height: 1.2; letter-spacing: -0.04em; }
	.intro { max-width: 650px; margin: 13px 0 0; color: #53657a; font-size: 1.08rem; line-height: 1.75; }
	.hero-actions { display: flex; align-items: center; justify-content: center; margin-top: 24px; }
	.primary-button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; border-radius: 9px; background: #22b24b; padding: 0 27px; color: white; font-weight: 800; text-decoration: none; box-shadow: 0 12px 28px rgb(34 178 75 / 20%); }
	.primary-button:hover { background: #16963b; }
	.text-link { color: #e8f4ff; font-size: 0.94rem; font-weight: 700; text-decoration: none; }
	.text-link span { margin-left: 5px; }
	.hero-meta { margin: 14px 0 0; color: #708096; font-size: 0.82rem; }
	.preview-notice { max-width: 720px; margin: 12px 0 0; color: #65758a; font-size: 0.78rem; line-height: 1.55; }
	.preview-notice strong { color: #a15812; }
	figure { width: 100%; max-width: 1180px; min-width: 0; margin: 42px 0 0; }
	figure img { display: block; width: 100%; max-width: 100%; height: auto; aspect-ratio: 1672 / 941; border: 1px solid rgb(59 100 145 / 18%); border-radius: 22px; object-fit: contain; box-shadow: 0 34px 90px rgb(35 75 112 / 24%); }
	.features { padding-block: 112px 124px; }
	.features .section-label { margin-top: 0; color: #0878ad; }
	h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.35rem); line-height: 1.16; letter-spacing: -0.045em; }
	.feature-grid { display: grid; gap: 20px; grid-template-columns: repeat(4, 1fr); margin-top: 52px; }
	@media (max-width: 900px) {
		.feature-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 560px) {
		.hero-inner { min-height: auto; padding-block: 42px 56px; }
		.product-title img { width: 58px; height: 58px; }
		h1 br, h2 br { display: none; }
		.hero-actions { width: 100%; }
		.hero-actions .primary-button { width: 100%; }
		figure { margin-top: 32px; }
		.features { padding-block: 80px; }
		.feature-grid { grid-template-columns: 1fr; margin-top: 38px; }
	}
</style>
